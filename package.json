{
  "name": "bnt-kit",
  "version": "0.1.0",
  "description": "Shared platform for bnt.hm apps on Cloudflare behind Access",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Benthem/bnt-kit.git" },
  "exports": {
    "./auth": "./src/auth.ts",
    "./d1-migrations": "./src/d1-migrations.ts",
    "./client": "./src/client.ts",
    "./pwa": "./src/pwa.ts",
    "./sw": "./src/sw.ts",
    "./testing/d1": "./src/testing/d1.ts",
    "./testing/purity": "./src/testing/purity.ts"
  },
  "bin": {
    "bnt-bundle-migrations": "./bin/bundle-migrations.mjs",
