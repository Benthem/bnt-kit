    "@babel/core": { "optional": true },
    "preact": { "optional": true },
    "wrangler": { "optional": true }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@cloudflare/workers-types": "^5.20261005.1",
    "@types/node": "^22.20.5",
    "preact": "^10.29.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
