{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "module": "es2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": [
      "node"
    ],
    "strict": true,
    "erasableSyntaxOnly": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/client.ts",
    "src/preact.ts",
    "src/pwa.ts",
    "test/client.test.ts"
  ]
}
